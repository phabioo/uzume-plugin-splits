// Sketch of a plugin API v1 manifest. The reference is docs/guides/plugin-api.md in the Uzume repository.
// The real manifest is plain JSON without comments.
{
  "id": "net.example.hello",           // unique plugin id
  "name": "Example",                       // display name
  "version": "1.0.0",                      // plugin version
  "api": 1,                                // plugin API version; unknown versions are rejected
  "type": "script",                        // "script" (sandboxed Lua); "tool" only for signed official plugins
  "requires": { "net.example.hello-core": "^1.0" },  // dependencies, loaded first
  "provides": ["example.team"],            // interfaces other plugins may call
  "games": [{ "system": "nds", "codes": ["ABC*"] }],     // supported systems and game codes
  "permissions": ["memory.read", "rom.read", "ui", "run.state"],
  "entry": "main.lua",                     // Lua entry point
  "assets": ["icons/", "i18n/"],           // bundled files (own artwork only, no game content)
  "settings": { }                          // schema for the generated settings page (open)
}
